# Copie este arquivo para ".env" e preencha.
# O .env fica SO no seu computador (esta no .gitignore).
# No GitHub, os mesmos valores vao em Settings → Secrets and variables → Actions.

# === App do Meta (pode ser UM app so para as duas contas) ===
# Meta for Developers → seu app → Instagram → API setup with Instagram login
ACCOUNT_A_INSTAGRAM_APP_ID=
ACCOUNT_A_META_APP_SECRET=
ACCOUNT_B_INSTAGRAM_APP_ID=
ACCOUNT_B_META_APP_SECRET=
# Contas backup: C espelha A, D espelha B (pode repetir o mesmo app id/secret)
ACCOUNT_C_INSTAGRAM_APP_ID=
ACCOUNT_C_META_APP_SECRET=
ACCOUNT_D_INSTAGRAM_APP_ID=
ACCOUNT_D_META_APP_SECRET=

# === Preenchidos AUTOMATICAMENTE por "node src/auth.js a" / "node src/auth.js b" ===
ACCOUNT_A_LONG_LIVED_TOKEN=
ACCOUNT_A_INSTAGRAM_USER_ID=
ACCOUNT_B_LONG_LIVED_TOKEN=
ACCOUNT_B_INSTAGRAM_USER_ID=
ACCOUNT_C_LONG_LIVED_TOKEN=
ACCOUNT_C_INSTAGRAM_USER_ID=
ACCOUNT_D_LONG_LIVED_TOKEN=
ACCOUNT_D_INSTAGRAM_USER_ID=

# === Cloudinary (compartilhado) — Dashboard → API Keys ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Opcional ===
# URL de redirecionamento cadastrada no app do Meta (padrao: https://localhost/)
# OAUTH_REDIRECT_URI=https://localhost/

# === Opcional: videos numa pasta fora do projeto (ex: Google Drive para computador) ===
# Se preenchido, "content-a/reel-01.mp4" passa a ser lido de CONTENT_A_DIR/reel-01.mp4
# Windows: CONTENT_A_DIR=G:\Meu Drive\insta\conta-a
# Mac:     CONTENT_A_DIR=/Users/voce/Google Drive/insta/conta-a
# CONTENT_A_DIR=
# CONTENT_B_DIR=
